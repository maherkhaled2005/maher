{
  "expo": {
    "name": "TecnoRexa",
    "slug": "tecno-rexa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A0F",
    "primaryColor": "#D4AF37",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tecnorexa.app",
      "versionCode": 1,
      "backgroundColor": "#070A0F",
      "adaptiveIcon": {
        "backgroundColor": "#070A0F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "lang": "ar"
    },
    "owner": "maher2006",
    "extra": {
      "eas": {
        "projectId": "151b9af2-362a-4101-9b46-c5d0c63f70af"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "./plugins/withDarkSplash",
      "expo-video"
    ]
  }
}
