# ============================================
# KING FRESH KF - Environment Variables
# ============================================

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Database
# Database file is automatically created at tecnorexa.db
NODE_ENV=development

# Port Configuration
PORT=3001

# ============================================
# AI & LLM Services
# ============================================

# Google Gemini API (for AI Hub)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (for advanced AI features)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Payment Processing (Stripe)
# ============================================

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_key

# Stripe Publishable Key (for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ============================================
# File Upload Configuration
# ============================================

# Upload directory path
UPLOAD_DIR=./uploads

# Max file size (in bytes) - default 10MB
MAX_FILE_SIZE=10485760

# ============================================
# Email Configuration (Optional)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ============================================
# API Configuration
# ============================================

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# ============================================
# Feature Flags
# ============================================

# Enable/Disable features
ENABLE_STRIPE=false
ENABLE_AI_HUB=true
ENABLE_DEVELOPER_TOOLS=true
